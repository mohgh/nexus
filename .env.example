# Nexus — Environment Configuration
# Copy to .env and fill in values: cp .env.example .env

APP_ENV=development
APP_ADDR=:8000

# Chapter 03+: Primary database
POSTGRES_DSN=postgres://nexus:nexus_secret@localhost:5432/nexus?sslmode=disable

# Chapter 04+: Cache, search, OLAP
REDIS_DSN=redis://localhost:6379/0
ELASTICSEARCH_URL=http://localhost:9200
CLICKHOUSE_DSN=clickhouse://nexus:nexus_secret@localhost:9000/nexus

# Chapter 05+: Schema Registry
SCHEMA_REGISTRY_URL=http://localhost:8081

# Chapter 06+: Replication
POSTGRES_REPLICA_DSN=postgres://nexus:nexus_secret@localhost:5433/nexus?sslmode=disable

# Chapter 07+: Sharding
SHARD_COUNT=4

# Chapter 08+: Temporal
TEMPORAL_HOST_PORT=localhost:7233

# Chapter 12+: Streaming
KAFKA_BROKERS=localhost:9092

# ─── Authentication (production-hardening) ───────────────────────────────────
# Every /api/v1 route requires an API key (X-API-Key or Authorization: Bearer).
# Set a bootstrap ADMIN key here so you have a credential to mint per-tenant
# keys via POST /api/v1/admin/api-keys. Generate a fresh, high-entropy value —
# never ship the example below:
#
#   printf 'nxs_admin_%s\n' "$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '=')"
#
# Then mint a tenant key (returns the secret exactly once):
#   curl -s -X POST localhost:8000/api/v1/admin/api-keys \
#     -H "X-API-Key: $NEXUS_BOOTSTRAP_ADMIN_KEY" \
#     -d '{"scope":"tenant","tenant_id":"<uuid>","name":"acme ingest"}'
#
# Leave empty only if you seed admin keys directly in the database.
NEXUS_BOOTSTRAP_ADMIN_KEY=

# Per-tenant rate limiting. On by default; each tenant gets a token bucket
# sized by its plan (free: 10 rps/20 burst, pro: 100/200, enterprise:
# 1000/2000; admin keys: 2000/4000). Responses carry X-RateLimit-* headers
# and 429s carry Retry-After. Set false to disable (load tests / workshops).
RATE_LIMIT_ENABLED=true
